+class TimeFormatTest {
+  @Test
+  fun testSystemFollowsThePlatform() {
+    assertTrue(uses24HourFormat(TimeFormat.SYSTEM, systemUses24Hour = true))
+    assertFalse(uses24HourFormat(TimeFormat.SYSTEM, systemUses24Hour = false))
+  }
+
+  @Test
