+actual fun copyImageToClipboard(image: ImageBitmap): Boolean =
+  try {
+    Toolkit.getDefaultToolkit().systemClipboard.setContents(imageToTransferable(image), null)
+    true
+  } catch (e: Exception) {
+    Log.e(TAG, "copyImageToClipboard error: $e")
+    false
